// Schema Prisma — Controle de Estoque FIFO por Validade
//
// Fonte: docs/arquitetura.md seção 3. Este arquivo é a tradução direta
// daquele modelo — ao alterar uma entidade aqui, atualize também a seção 3.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Em produção com banco gerenciado, `url` é a string **com pooler** (é por
  // ela que a aplicação fala) e `directUrl` é a conexão direta, usada só pelo
  // `prisma migrate`. A separação não é otimização: o pooler em modo transaction
  // não sustenta o advisory lock que a migração usa, e migrar por ele falha.
  // Em desenvolvimento as duas apontam para o mesmo Postgres do docker-compose.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Papel {
  ATENDENTE
  GESTOR
}

enum StatusUnidade {
  EM_ESTOQUE
  VENDIDA
  DESCARTADA
}

model Usuario {
  id        String @id @default(uuid())
  nome      String
  email     String @unique
  senhaHash String
  papel     Papel

  saidas              Saida[]          @relation("SaidaExecutadaPor")
  saidasAutorizadas   Saida[]          @relation("SaidaAutorizadaPor")
  descartes           Descarte[]
  eventos             EventoLog[]
  unidadesRegistradas UnidadeProduto[]
  inscricoesPush      InscricaoPush[]
}

model Produto {
  id            String @id @default(uuid())
  codigoInterno String @unique
  nome          String
  marca         String
  categoria     String

  // Inativação em vez de exclusão: um produto com unidades já vendidas ou
  // descartadas não pode sumir sem levar junto o histórico da pesquisa.
  ativo Boolean @default(true)

  unidades UnidadeProduto[]
}

model UnidadeProduto {
  id              String        @id @default(uuid())
  produtoId       String
  produto         Produto       @relation(fields: [produtoId], references: [id])
  codigoQr        String        @unique
  dataValidade    DateTime      @db.Date // RNF01: DATE, nunca DATETIME
  status          StatusUnidade @default(EM_ESTOQUE)
  dataEntrada     DateTime      @default(now())
  registradoPorId String
  registradoPor   Usuario       @relation(fields: [registradoPorId], references: [id])

  saida    Saida?
  descarte Descarte?
  alertas  Alerta[]

  // Sustenta a consulta FIFO (docs/arquitetura.md seção 4, passo 4),
  // executada a cada leitura de QR.
  @@index([produtoId, status, dataValidade])
}

model Saida {
  id                    String         @id @default(uuid())
  unidadeId             String         @unique
  unidade               UnidadeProduto @relation(fields: [unidadeId], references: [id])
  usuarioId             String
  usuario               Usuario        @relation("SaidaExecutadaPor", fields: [usuarioId], references: [id])
  dataHora              DateTime       @default(now())
  alertaFifoDisparado   Boolean        @default(false)
  tentativasAteAcerto   Int            @default(0)
  vendaDeUnidadeVencida Boolean        @default(false)
  justificativaOverride String?

  // Preenchido apenas no override da seção 6.1 do PRD, sempre por um GESTOR.
  autorizadoPorId String?
  // onDelete: Restrict — o padrão do Prisma para relação opcional seria
  // SET NULL, que apagaria quem autorizou a venda de unidade vencida. Esse
  // registro tem peso legal (PRD seção 6.1) e não pode evaporar.
  autorizadoPor   Usuario? @relation("SaidaAutorizadaPor", fields: [autorizadoPorId], references: [id], onDelete: Restrict)

  sessaoVendaId String?
}

model Descarte {
  id        String         @id @default(uuid())
  unidadeId String         @unique
  unidade   UnidadeProduto @relation(fields: [unidadeId], references: [id])
  usuarioId String
  usuario   Usuario        @relation(fields: [usuarioId], references: [id])
  dataHora  DateTime       @default(now())
  motivo    String
}

model ConfiguracaoAlerta {
  id               String   @id @default(uuid())
  diasAntecedencia Int
  canal            String
  ativo            Boolean  @default(true)
  alertas          Alerta[]
}

model Alerta {
  id             String             @id @default(uuid())
  unidadeId      String
  unidade        UnidadeProduto     @relation(fields: [unidadeId], references: [id])
  configuracaoId String
  configuracao   ConfiguracaoAlerta @relation(fields: [configuracaoId], references: [id])
  geradoEm       DateTime           @default(now())
  lidoEm         DateTime?

  // T18: o alerta é a notícia de que a unidade entrou na janela daquela
  // configuração, e essa notícia acontece uma vez só. A varredura roda
  // repetidamente sobre o mesmo estoque, então a unicidade é o que a torna
  // idempotente — e ela fica no banco, e não só na aplicação como em
  // ConfiguracaoAlerta, porque aqui quem escreve é um job automático e a
  // contagem de alertas emitidos é dado da pesquisa (RF13).
  @@unique([unidadeId, configuracaoId])
}

// T19b — um aparelho inscrito para receber a notificação push do alerta
// proativo (RF08). A inscrição é do navegador, não da pessoa: a mesma gestora
// no celular e no computador da loja são duas linhas.
model InscricaoPush {
  id String @id @default(uuid())

  // A URL que o serviço de push do navegador (FCM, Mozilla, Apple) expõe para
  // este aparelho. É credencial de envio: nunca sai em resposta de API, em
  // EventoLog nem em log de servidor.
  endpoint String @unique

  // As duas chaves que a RFC 8291 exige para cifrar o payload. Vêm do
  // navegador e são opacas para o servidor.
  p256dh String
  auth   String

  // Quem inscreveu o aparelho. O envio confere o papel aqui, e não no momento
  // da inscrição: uma conta rebaixada de GESTOR para ATENDENTE deixa de
  // receber sem que ninguém precise limpar a tabela.
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  criadoEm DateTime @default(now())
}

model EventoLog {
  id         String   @id @default(uuid())
  tipoEvento String
  // unidadeId e produtoId ficam sem FK de propósito: a seção 5 do PRD os
  // declara nullable e sem chave, para que o log de pesquisa sobreviva a
  // qualquer entidade que ele descreve.
  unidadeId  String?
  produtoId  String?
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  payload    Json
  ocorridoEm DateTime @default(now())

  // RNF05: append-only. Sem @updatedAt, sem endpoint de UPDATE/DELETE
  // na aplicação.
}

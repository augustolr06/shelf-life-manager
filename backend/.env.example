# Conexão com o PostgreSQL (PostgreSQL 15+ — ver docs/arquitetura.md seção 1)
DATABASE_URL="postgresql://estoque:estoque@localhost:5434/estoque_fifo?schema=public"

# Conexão DIRETA com o mesmo banco, usada só pelo `prisma migrate`.
# Em desenvolvimento é idêntica à de cima — copie e cole. Ela existe por causa
# da produção: lá o DATABASE_URL passa por um pooler, e o pooler em modo
# transaction não sustenta o advisory lock da migração.
DIRECT_URL="postgresql://estoque:estoque@localhost:5434/estoque_fifo?schema=public"

# Segredo de assinatura do JWT de sessão (T03).
# Gere o seu com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-por-um-valor-aleatorio-de-32-bytes"

# Porta em que o Fastify escuta
PORT=3333

# Origem permitida do frontend (usada a partir de T03)
FRONTEND_ORIGIN="http://localhost:5173"

# Verbosidade do log: fatal, error, warn, info, debug, trace, silent.
# `info` registra uma linha por requisição. Nenhum nível registra corpo, então
# a senha do login não chega ao log em nível nenhum.
LOG_LEVEL="info"

# Intervalo da varredura de alertas proativos, em horas (T18). Padrão 24.
# Só tem efeito com o agendador interno ligado (abaixo).
ALERTA_INTERVALO_HORAS=24

# Quem dispara a varredura da RF08 (T23).
#   true  — o `setInterval` dentro deste processo, como em T18. Correto em
#           qualquer hospedagem com processo de longa duração.
#   false — nada dispara aqui dentro; a varredura depende de um agendador
#           externo chamando GET /interno/varredura-alertas. **Obrigatório em
#           hospedagem serverless**, onde o intervalo nunca dispararia e a
#           varredura de inicialização rodaria a cada cold start.
ALERTA_AGENDADOR_INTERNO=true

# Segredo que autoriza GET /interno/varredura-alertas (T23). Opcional: sem ele
# a rota responde 503 e o servidor sobe normal — mesma postura das chaves VAPID.
# Gere o seu com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# Chaves VAPID do Web Push (T19b). Opcionais: sem elas o servidor sobe normal e
# a notificação push fica desligada (as rotas de inscrição respondem 503).
# Gere o par com:  npm run push:chaves
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contato exigido pela RFC 8292 (mailto: ou https:).
VAPID_SUBJECT="mailto:estoque@exemplo.local"
